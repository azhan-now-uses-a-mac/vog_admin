{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vog-donate",
  "compatibility_date": "2026-09-27",
  // Serve on the free vog-donate.<account>.workers.dev address.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // React Router handles /<slug>; unknown paths must serve index.html.
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  // avisionofgood.com is on Cloudflare; this creates the DNS record on deploy.
  "routes": [{ "pattern": "donate.avisionofgood.com", "custom_domain": true }]
}
