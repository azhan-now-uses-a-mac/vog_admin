{
  "name": "avisionofgood",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:donate": "npm run dev --workspace apps/donate",
    "dev:volunteer": "npm run dev --workspace apps/volunteer",
    "dev:admin": "npm run dev --workspace apps/admin",
    "build:donate": "npm run build --workspace apps/donate",
    "build:volunteer": "npm run build --workspace apps/volunteer",
    "build:admin": "npm run build --workspace apps/admin",
    "build": "npm run build --workspaces",
    "deploy:donate": "npm run deploy --workspace apps/donate",
    "deploy:volunteer": "npm run deploy --workspace apps/volunteer",
    "deploy:admin": "npm run deploy --workspace apps/admin",
    "deploy:sites": "npm run deploy:donate && npm run deploy:volunteer && npm run deploy:admin"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@neon/config": "^1.7.3",
    "@neon/env": "^1.4.4",
    "@neon/functions": "^0.11.0",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.142.0"
  }
}
